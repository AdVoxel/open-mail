{
  "name": "@mail-app/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run export:web -w @mail-app/mobile && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Personal mail client",
  "author": "Eduardo Rodrigues",
  "build": {
    "appId": "com.openmail.desktop",
    "productName": "Mail",
    "electronVersion": "45.2.2",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Mail-Setup-${version}.${ext}"
    },
    "linux": {
      "category": "Network",
      "maintainer": "Eduardo Rodrigues",
      "artifactName": "Mail-${version}.${ext}"
    }
  }
}
