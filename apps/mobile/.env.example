# Copy to .env.local. Defaults the app uses until you change them in Settings → Server.
# Web/desktop on this computer: http://localhost:8787
# A phone: your computer's Wi-Fi IP (phone and computer on the same network), e.g. http://192.168.1.20:8787
EXPO_PUBLIC_MAIL_API_URL=http://localhost:8787
# The same MAIL_APP_TOKEN as the server's .env
EXPO_PUBLIC_MAIL_APP_TOKEN=
