# Mail server settings. Copy to .env (never commit .env).

# Shared secret the apps send as "Authorization: Bearer <token>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MAIL_APP_TOKEN=

# Where the server listens. 0.0.0.0 lets other devices on your network (phone) reach it.
MAIL_APP_HOST=0.0.0.0
MAIL_APP_PORT=8787

# Optional: where accounts.json, scheduled.json and secret.key live (default: server/data).
# MAIL_APP_DATA_DIR=
# Optional: base64 32-byte key used to encrypt saved passwords. Without it, server/data/secret.key is created.
# MAIL_APP_SECRET_KEY=

# Optional: "Sign in with Google" (see README). App passwords work without this.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: accounts defined here instead of added from the apps.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# ICLOUD_USER=
# ICLOUD_APP_PASSWORD=
# ZOHO_USER=
# ZOHO_APP_PASSWORD=
